CLI-ENRICHER.DATABASE=example

# TicketMaster - https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/
TICKETMASTER_API_TOKEN=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2/